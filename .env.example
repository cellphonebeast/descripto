# Optional: copy to .env.local and fill only the providers you use.
# Settings → Connections is the recommended setup. Never commit real keys.
GROQ_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
AUPHONIC_API_KEY=

# Optional local Whisper fallback: executable on PATH, or an absolute path.
LOCAL_WHISPER_BIN=whisper
LOCAL_WHISPER_MODEL=small
